# ==============================================================================
# The Monroe Fund - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and populate with your own credentials:
#   cp .env.example .env
#
# DO NOT commit '.env' to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Required for Intelligence Tier)
# ------------------------------------------------------------------------------
# Used by python-brain for agent reasoning, tool orchestration, and vector RAG.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding model used for SEC filing vector indexing and semantic retrieval.
# Default: gemini-embedding-2 (fallback: text-embedding-004)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ------------------------------------------------------------------------------
# 2. SEC EDGAR API (Required for SEC Data Retrieval)
# ------------------------------------------------------------------------------
# The SEC strictly requires a declared User-Agent header in the following format:
#   Sample Company Name AdminContact@<domain>.com
# See SEC guidelines: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=TheMonroeFund your_name_or_admin@domain.com

# ------------------------------------------------------------------------------
# 3. Finnhub Market Data API (Market Feeds & Fundamentals)
# ------------------------------------------------------------------------------
# Used for real-time market quotes, financial news, sentiment, and earnings data.
# Obtain an API key from Finnhub: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# ------------------------------------------------------------------------------
# 4. Alpaca Trading API (Execution & Market Data Streaming)
# ------------------------------------------------------------------------------
# Used by the execution tier for paper/live trading and WebSocket quote feeds.
# Obtain keys from Alpaca: https://alpaca.markets/
ALPACA_API_KEY_ID=your_alpaca_api_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here
# Base URL:
#   Paper Trading: https://paper-api.alpaca.markets
#   Live Trading:  https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ------------------------------------------------------------------------------
# 5. Database / Persistence Tier (PostgreSQL / Cloud SQL)
# ------------------------------------------------------------------------------
# Connection string for transactional ledger, accounts, and pgvector embeddings.
DATABASE_URL=postgresql://postgres:password@localhost:5432/monroe_fund

# ------------------------------------------------------------------------------
# 6. Runtime & Environment Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
