# The Monroe Fund - Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and configure your local settings:
#   cp .env.example .env
#
# See docs/LOCAL_SETUP.md for ADC, Cloud SQL Auth Proxy, and ~/.pgpass setup.
# Keep passwords out of this file and do not commit your local .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud (Required for Intelligence Tier)
# ------------------------------------------------------------------------------
# Used by python-brain for agent reasoning, tool orchestration, and vector RAG.
# Authenticate locally with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True

# Embedding model used for SEC filing vector indexing and semantic retrieval.
# Changing the model selects a different filing index.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ------------------------------------------------------------------------------
# 2. SEC EDGAR API (Required for SEC Data Retrieval)
# ------------------------------------------------------------------------------
# The SEC strictly requires a declared User-Agent header in the following format:
#   Sample Company Name AdminContact@<domain>.com
# See SEC guidelines: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=TheMonroeFund your_name_or_admin@domain.com

# ------------------------------------------------------------------------------
# 3. Market Data APIs (Optional)
# ------------------------------------------------------------------------------
# Without a key, only that provider's market data tools are unavailable.
# Free plans are rate limited; the tools report plan and rate-limit errors.
# Deployed services should receive these from Secret Manager, not this file.
#
# Massive (formerly Polygon.io): daily price bars, previous close, ticker details.
# Obtain an API key from Massive: https://massive.com/
MASSIVE_API_KEY=your_massive_api_key_here
# Finnhub: quotes, company news, basic financial metrics, earnings calendar.
# Obtain an API key from Finnhub: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# ------------------------------------------------------------------------------
# 4. Alpaca Trading API (Reserved for future integration)
# ------------------------------------------------------------------------------
# Used by the execution tier for paper/live trading and WebSocket quote feeds.
# Obtain keys from Alpaca: https://alpaca.markets/
ALPACA_API_KEY_ID=your_alpaca_api_key_id_here
ALPACA_API_SECRET_KEY=your_alpaca_secret_key_here
# Base URL:
#   Paper Trading: https://paper-api.alpaca.markets
#   Live Trading:  https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ------------------------------------------------------------------------------
# 5. Database / Persistence Tier (PostgreSQL / Cloud SQL)
# ------------------------------------------------------------------------------
# Local Cloud SQL Auth Proxy binds to 127.0.0.1:5433 in the setup guide.
# Uncomment the reader for PostgreSQL retrieval. Uncomment the writer to build
# missing indexes. With both unset, filing retrieval uses an in-memory index.
# Put the matching passwords in ~/.pgpass (chmod 600) until the local Secret
# Manager workflow is available. These connection strings contain no passwords.
# SEC_RAG_READ_DSN=host=127.0.0.1 port=5433 dbname=monroe_fund user=sec_reader
# SEC_RAG_WRITE_DSN=host=127.0.0.1 port=5433 dbname=monroe_fund user=sec_index_writer

# The standalone SEC importer uses standard libpq variables such as PGDATABASE,
# PGHOST, PGPORT, and PGUSER. DATABASE_URL is reserved for future application use.

# ------------------------------------------------------------------------------
# 6. Runtime & Environment Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
